<section id="packages">
    <div id="top-content">
        <img src="img/packages/icongreen.svg" alt="greenoutline">
        <h1 class="section-title">Popular packages</h1>
        <div id="package-button-container">
        <button id="left-arrow"><img src="img/packages/vector_left.png" alt="left icon"></button>
        <button id="right-arrow"><img src="img/packages/vector.png" alt="left icon"></button>
        </div>
    </div>
    <ul id="package-card-container">
        <li class="package-card" id="card-1">
            <img src="img/packages/card1.jpg" alt="coffeshop" class="img-scaler">
            <p>The Basic package to start your promotion</p>
            <div class="package-status-bar">
                <ul class="user-icons">
                    <li class="icon-1" ></li>
                    <li class="icon-2" ></li>
                    <li class="icon-3" ></li>
                </ul>
                <h4>200K+ users</h4>
                <h3>$89.00</h3>
            </div>
        </li>

        <li class="selected package-card" id="card-2">
            <img src="img/packages/card3.jpg" alt="coffeshop" class="img-scaler">
            <p>The standard package to grow your business</p>
            <div class="package-status-bar">
            <ul class="user-icons">
                <li class="icon-1" ></li>
                <li class="icon-2" ></li>
                <li class="icon-3" ></li>
            </ul>
            <h4>140K+ users</h4>
            <h3>$109.00</h3>
            </div>
        </li>

        <li class="package-card" id="card-3">
            <img src="img/packages/card2.jpg" alt="coffeshop" class="img-scaler">
            <p>The premium package to boost your promotion</p>
            <div class="package-status-bar">
            <ul class="user-icons">
                <li class="icon-1" ></li>
                <li class="icon-2" ></li>
                <li class="icon-3" ></li>
            </ul>
            <h4>99K+ users</h4>
            <h3>$149.00</h3>
            </div>
        </li>
    </ul>

</section>